# ==================================================
# SAMARTHYA AI APPLICATION
# ==================================================

APP_NAME=SAMARTHYA_AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5190
LOG_LEVEL=INFO

# ==================================================
# FRONTEND AND BACKEND URLS
# ==================================================

FRONTEND_URL=http://localhost:8010
API_BASE_URL=http://localhost:5190
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:8010

# ==================================================
# SUPABASE
# ==================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ==================================================
# SUPABASE POSTGRESQL
# ==================================================

DATABASE_URL=

# ==================================================
# SUPABASE STORAGE
# ==================================================

SUPABASE_LEARNING_BUCKET=learning-materials
SUPABASE_PROFILE_BUCKET=profile-avatars
SUPABASE_STUDENT_DOCUMENTS_BUCKET=student-documents

MAX_UPLOAD_SIZE_MB=20

# ==================================================
# OPENAI / LLM CONFIGURATION
# ==================================================
# Supports official OpenAI, OpenRouter, Groq,
# Ollama, LM Studio and compatible APIs.

OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL_ID=""

OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# ==================================================
# AI FEATURES
# ==================================================

AI_ENABLED=false
ENABLE_AI_QUIZZES=true
ENABLE_RAG=true
ENABLE_VECTOR_SEARCH=true

# ==================================================
# EMBEDDING CONFIGURATION
# Separate configuration from the chat model.

EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL_ID=""
EMBEDDING_DIMENSIONS=

# ==================================================
# ASSESSMENTS
# ==================================================

DEFAULT_ASSESSMENT_DURATION_MINUTES=30
MAX_ASSESSMENT_ATTEMPTS=3

# ==================================================
# SECURITY
# ==================================================

JWT_AUDIENCE=authenticated
RATE_LIMIT_ENABLED=true

# ==================================================
# DOCUMENT PROCESSING
# ==================================================

DOCUMENT_PROCESSING_WORKERS=2

# ==================================================
# OPTIONAL EMAIL SETTINGS
# ==================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
